<%@ include file="header.jspf" %><h1><c:out value="${file.name}"/></h1>
<c:if test="${not empty param.saved}"><p class="notice" role="status">Changes saved.</p></c:if>
<section><dl><dt>Size</dt><dd><c:out value="${file.size}"/> bytes</dd><dt>Uploaded (UTC)</dt><dd><c:out value="${file.createdAt}"/></dd><dt>Type</dt><dd><c:out value="${file.mime}"/></dd></dl><a class="button" href="${pageContext.request.contextPath}/download?id=${file.id}">Download</a>
<form method="post" action="${pageContext.request.contextPath}/describe"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${file.id}"><label for="description">Description</label><textarea id="description" name="description" maxlength="1000"><c:out value="${file.description}"/></textarea><button>Save Description</button></form></section>
<section><h2>Access and Versions</h2><a class="button" href="${pageContext.request.contextPath}/policy?id=${file.id}">Manage Access Settings</a><a class="button" href="${pageContext.request.contextPath}/versions?id=${file.id}">Version History</a><a href="${pageContext.request.contextPath}/access?id=${file.id}">Open Viewer or Download</a></section>
<section><h2>Classification and Catalogue</h2><form method="post" action="${pageContext.request.contextPath}/settings"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${file.id}"><label for="classification">Classification</label><select id="classification" name="classification"><option value="NORMAL" ${file.classification eq 'NORMAL' ? 'selected' : ''}>Normal</option><option value="CONFIDENTIAL" ${file.classification eq 'CONFIDENTIAL' ? 'selected' : ''}>Confidential — OTP required</option></select><label><input type="checkbox" name="listed" ${file.listed ? 'checked' : ''}>List in the authenticated request catalogue</label><small>Unlisted files remain private. Listing reveals the display name, owner and description to registered users; it grants no content access.</small><br><button>Save File Settings</button></form></section>
<section><h2>Delete File</h2><p>Deletion blocks future downloads and revokes all shares.</p><form method="post" action="${pageContext.request.contextPath}/delete" data-confirm="Delete this file and revoke all access?"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${file.id}"><button class="danger">Delete File</button></form></section><%@ include file="footer.jspf" %>
