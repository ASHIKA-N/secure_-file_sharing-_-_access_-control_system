<%@ include file="header.jspf" %>
<h1>Alerts for My Files</h1><p>These rules indicate unusual activity, not confirmed abuse. Counts include only activity relevant to your files. Accounts are never disabled automatically.</p><c:if test="${empty rows}"><section>No file alerts.</section></c:if><section class="table-wrap"><table><thead><tr><th>Rule</th><th>Count / window</th><th>File reference</th><th>Status</th><th>Time (UTC)</th></tr></thead><tbody><c:forEach var="a" items="${rows}"><tr><td><c:out value="${a.rule}"/></td><td><c:out value="${a.count}"/> in <c:out value="${a.window}"/> seconds</td><td><c:out value="${a.file}"/></td><td><c:out value="${a.status}"/></td><td><c:out value="${a.createdAt}"/></td></tr></c:forEach></tbody></table></section><c:set var="hasNext" value="${rows.size() eq 20}"/><%@ include file="pagination.jspf" %>
<%@ include file="footer.jspf" %>
