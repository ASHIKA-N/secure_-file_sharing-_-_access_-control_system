<%@ include file="header.jspf" %>
<h1>OTP Verification</h1><section><c:choose><c:when test="${challenge.mode eq 'LOCAL'}"><p class="notice">Development-only local mailbox mode. No email was sent. <a href="${pageContext.request.contextPath}/mailbox" target="_blank" rel="noopener">Open My Local Mailbox</a></p></c:when><c:otherwise><p>The code was sent through the configured SMTP service.</p></c:otherwise></c:choose><p>Expires at <c:out value="${challenge.expiresAt}"/> UTC. Attempts remaining: <c:out value="${challenge.remaining}"/>.</p><form method="post" action="${pageContext.request.contextPath}/otp/verify"><%@ include file="csrf.jspf" %><input type="hidden" name="challenge" value="${challenge.id}"><label for="code">Six-digit code</label><input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required><button>Verify Code</button></form><form method="post" action="${pageContext.request.contextPath}/otp/send"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${challenge.fileId}"><input type="hidden" name="operation" value="${challenge.operation}"><button>Resend Code</button></form><p>Wait 60 seconds between codes; at most five may be issued in ten minutes. A verified code authorizes one operation for two minutes. Revocation and all access settings still apply.</p></section>
<%@ include file="footer.jspf" %>
