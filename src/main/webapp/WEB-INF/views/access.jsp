<%@ include file="header.jspf" %>
<h1><c:out value="${access.name}"/></h1><section><dl><dt>Version</dt><dd><c:out value="${access.versionNumber}"/></dd><dt>Classification</dt><dd><c:out value="${access.classification}"/></dd><dt>Views remaining</dt><dd><c:out value="${access.viewsRemaining}"/></dd><dt>Downloads remaining</dt><dd><c:out value="${access.downloadsRemaining}"/></dd><dt>Expiry (UTC)</dt><dd><c:out value="${access.expiresAt}"/></dd></dl>
<p>Limited ancestor budgets are shared with delegated recipients. A transfer is counted when the verified response is ready to start; retrying can consume another transfer. Range/resume is not supported.</p>
<c:choose><c:when test="${access.otp}"><p>OTP verification is required for each new viewing session or download.</p><c:if test="${access.viewAllowed}"><form method="post" action="${pageContext.request.contextPath}/otp/send"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${access.id}"><input type="hidden" name="operation" value="VIEW"><button>Verify OTP to View</button></form></c:if><c:if test="${access.downloadAllowed}"><form method="post" action="${pageContext.request.contextPath}/otp/send"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${access.id}"><input type="hidden" name="operation" value="DOWNLOAD"><button>Verify OTP to Download</button></form></c:if></c:when><c:otherwise>
<c:if test="${access.viewAllowed}"><form method="post" action="${pageContext.request.contextPath}/viewer/open"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${access.id}"><input type="hidden" name="initiation" value="${initiation}"><button>Open Viewer</button></form></c:if><c:if test="${access.downloadAllowed}"><form method="post" action="${pageContext.request.contextPath}/transfer"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${access.id}"><button>Start Download</button></form></c:if></c:otherwise></c:choose>
<c:if test="${not access.downloadAllowed}"><p>The file owner has disabled downloads.</p></c:if><a class="button" href="${pageContext.request.contextPath}/policy?id=${access.id}">Share</a><p>Viewing still allows screenshots, recordings and browser capture. Watermarks are a deterrent, not DRM. A downloaded copy can be forwarded outside this application.</p></section>
<%@ include file="footer.jspf" %>
