<%@ include file="header.jspf" %>
<h1><c:out value="${received ? 'Requests Received' : 'My Requests'}"/></h1><p>Approval opens the policy form. It never grants unrestricted access automatically.</p><c:if test="${empty rows}"><section>No access requests found.</section></c:if><c:forEach var="r" items="${rows}"><section><h2><c:out value="${r.name}"/></h2><p><c:out value="${r.email}"/> · <span class="badge"><c:out value="${r.status}"/></span> · <c:out value="${r.createdAt}"/></p><p><c:out value="${r.reason}"/></p><p>Decision note: <c:out value="${r.note}"/></p><c:if test="${r.status eq 'PENDING'}"><c:choose><c:when test="${received}"><a class="button" href="${pageContext.request.contextPath}/policy?request=${r.id}">Approve with Settings</a><form method="post" action="${pageContext.request.contextPath}/request/decide"><%@ include file="csrf.jspf" %><input type="hidden" name="request" value="${r.id}"><input type="hidden" name="decision" value="REJECTED"><label for="note-${r.id}">Decision note</label><input id="note-${r.id}" name="note" maxlength="500"><button>Reject Request</button></form></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/request/decide"><%@ include file="csrf.jspf" %><input type="hidden" name="request" value="${r.id}"><input type="hidden" name="decision" value="CANCELLED"><button>Cancel Request</button></form></c:otherwise></c:choose></c:if></section></c:forEach><c:set var="hasNext" value="${rows.size() eq 20}"/><%@ include file="pagination.jspf" %>
<%@ include file="footer.jspf" %>
