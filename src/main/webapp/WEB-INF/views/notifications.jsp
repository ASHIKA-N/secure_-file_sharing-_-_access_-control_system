<%@ include file="header.jspf" %>
<h1>Notifications</h1><c:if test="${empty rows}"><section>No notifications.</section></c:if><c:forEach var="n" items="${rows}"><section><p><c:out value="${n.message}"/></p><small><c:out value="${n.createdAt}"/> UTC</small><c:if test="${not n.read}"><form method="post" action="${pageContext.request.contextPath}/notification/read"><%@ include file="csrf.jspf" %><input type="hidden" name="notice" value="${n.id}"><button>Mark Read</button></form></c:if></section></c:forEach><c:set var="hasNext" value="${rows.size() eq 20}"/><%@ include file="pagination.jspf" %>
<%@ include file="footer.jspf" %>
