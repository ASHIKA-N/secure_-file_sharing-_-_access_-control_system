<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Secure File Sharing</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"><script defer src="${pageContext.request.contextPath}/assets/js/app.js"></script></head><body>
<header><strong>Secure File Sharing</strong><nav aria-label="Main navigation">
<c:choose><c:when test="${not empty sessionScope.userId}">
<a href="${pageContext.request.contextPath}/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/files">My Files</a><a href="${pageContext.request.contextPath}/upload">Upload File</a><a href="${pageContext.request.contextPath}/shared">Shared with Me</a><a href="${pageContext.request.contextPath}/activity">My Activity</a>
<a href="${pageContext.request.contextPath}/catalogue">Request Catalogue</a><a href="${pageContext.request.contextPath}/requests">My Requests</a><a href="${pageContext.request.contextPath}/received-requests">Requests Received</a><a href="${pageContext.request.contextPath}/notifications">Notifications</a><a href="${pageContext.request.contextPath}/owner-alerts">File Alerts</a>
<c:if test="${account.role eq 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin/users.xhtml">Administration</a></c:if>
<form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button type="submit">Sign Out</button></form>
</c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">Sign In</a><a href="${pageContext.request.contextPath}/register">Register</a></c:otherwise></c:choose>
</nav></header><main id="main">
