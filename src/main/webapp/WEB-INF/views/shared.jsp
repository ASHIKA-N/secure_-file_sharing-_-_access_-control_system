<%@ include file="header.jspf" %><h1>Shared with Me</h1><p>Only active shares appear here. A download saves a copy to your device.</p>
<form method="get" class="toolbar"><label for="q">Search filenames<input id="q" name="q" maxlength="100" value="<c:out value='${param.q}'/>"></label><button>Search</button></form>
<c:choose><c:when test="${empty files}"><section><p>No active files have been shared with you.</p></section></c:when><c:otherwise><section class="table-wrap"><table><thead><tr><th>File</th><th>Owner</th><th>Size (bytes)</th><th>Expires (UTC)</th><th>Allowances / actions</th></tr></thead><tbody>
<c:forEach var="f" items="${files}"><tr><td><c:out value="${f.name}"/><br><small><c:out value="${f.description}"/></small></td><td><c:out value="${f.owner}"/></td><td><c:out value="${f.size}"/></td><td><c:out value="${f.expiresAt}"/></td><td><span>Views: <c:out value="${f.viewsRemaining}"/>; downloads: <c:out value="${f.downloadsRemaining}"/></span><br><a href="${pageContext.request.contextPath}/access?id=${f.id}">View Access and Allowed Actions</a><br><a href="${pageContext.request.contextPath}/policy?id=${f.id}">Share</a></td></tr></c:forEach></tbody></table></section></c:otherwise></c:choose>
<c:set var="hasNext" value="${files.size() eq 20}"/><%@ include file="pagination.jspf" %><%@ include file="footer.jspf" %>
