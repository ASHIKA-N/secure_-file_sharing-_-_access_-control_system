<%@ include file="header.jspf" %>
<h1>Authenticated Request Catalogue</h1><p>Only files deliberately listed by their owners appear here. Listing permits access requests, not viewing or downloading.</p><c:if test="${empty rows}"><section>No files are listed.</section></c:if><c:forEach var="f" items="${rows}"><section><h2><c:out value="${f.name}"/></h2><p>Owner: <c:out value="${f.owner}"/></p><p><c:out value="${f.description}"/></p><form method="post" action="${pageContext.request.contextPath}/request/submit"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${f.id}"><label for="reason-${f.id}">Reason for access</label><textarea id="reason-${f.id}" name="reason" maxlength="500" required></textarea><button>Request Access</button></form></section></c:forEach><c:set var="hasNext" value="${rows.size() eq 20}"/><%@ include file="pagination.jspf" %>
<%@ include file="footer.jspf" %>
