# Documentation only: Java and Tomcat do not automatically load this file.
SF_DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
SF_DB_USER=securefiles_app
SF_DB_PASSWORD=replace-with-oracle-schema-password
SF_STORAGE_DIR=C:\securefiles-data
SF_MASTER_KEY=replace-with-base64-of-32-random-bytes
SF_QUOTA_BYTES=104857600
# false only for local HTTP. Use true with HTTPS.
SF_COOKIE_SECURE=false
# Independent random Base64 secrets (at least 32 bytes each).
SF_OTP_SECRET=replace-with-independent-otp-hmac-secret
SF_AUDIT_SECRET=replace-with-independent-checkpoint-hmac-secret
SF_CHECKPOINT_DIR=C:\securefiles-audit-checkpoints
SF_MAIL_MODE=LOCAL
SF_LOCAL_MAILBOX_DIR=C:\securefiles-local-mailbox
# SMTP mode requires TLS and the following settings.
SF_SMTP_HOST=smtp.example.test
SF_SMTP_PORT=587
SF_SMTP_USER=replace-with-smtp-user
SF_SMTP_PASSWORD=replace-with-smtp-password
SF_SMTP_FROM=securefiles@example.test
# Optional Unicode TrueType font for personalized PDF derivatives.
SF_PDF_FONT=C:\Windows\Fonts\arial.ttf
# Set these only while running the explicit bootstrap command.
SF_ADMIN_NAME=Local Administrator
SF_ADMIN_EMAIL=admin@example.test
SF_ADMIN_PASSWORD=replace-with-a-private-passphrase